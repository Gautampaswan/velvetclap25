# Razorpay (Test keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Public site URL (custom domain) — used in sitemap.xml & robots.txt for Google
# SITE_URL=https://velvetclap.com

# Staff catalog admin (/admin.html) — use a long random password
ADMIN_PASSWORD=change-me-to-a-strong-secret

# Cloudinary catalog thumbnails (optional; set CLOUDINARY_AUTO_TRANSFORM=false to disable)
# CLOUDINARY_CATALOG_TRANSFORM=w_800,h_1000,c_fill,f_auto,q_auto

# SMS (MSG91 India) — order confirm + shipped alerts (optional; costs per SMS)
# https://msg91.com/ → API keys
MSG91_AUTH_KEY=
MSG91_SENDER_ID=VELVCL
# Set ORDER_SMS=false to use email-only alerts (zero MSG91 cost)
# ORDER_SMS=false

# Email alerts (free with Gmail) — shop inbox on every new order
# 1) Google Account → Security → 2-Step Verification → App passwords → create "Mail"
# 2) Use that 16-char password as GMAIL_APP_PASSWORD (not your normal Gmail password)
GMAIL_USER=your-shop@gmail.com
GMAIL_APP_PASSWORD=
# Where new-order alerts go (defaults to GMAIL_USER)
SHOP_ORDERS_EMAIL=your-shop@gmail.com
# ORDER_EMAIL_SHOP=false to disable shop alerts
# Display name customers see on order/shipped email (From: Velvetclap25 Orders <your@gmail.com>)
EMAIL_FROM_NAME=Velvetclap25 Orders

# Generic SMTP (optional instead of Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Style desk / support bot (WhatsApp + phone shown in chat widget)
SUPPORT_WHATSAPP=919876543210
SUPPORT_PHONE=919876543210
# SUPPORT_PHONE_DISPLAY=+91 98765 43210
# SUPPORT_HOURS=Mon–Sat, 10 AM – 7 PM (Dehradun)

# Server port (Render sets PORT automatically)
PORT=3000
